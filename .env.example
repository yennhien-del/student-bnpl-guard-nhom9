# Sao chép file này thành .env rồi điền khóa thật. KHÔNG commit file .env.
# Nếu để trống, ứng dụng vẫn chạy bình thường; chỉ chatbot Guard AI báo "chưa cấu hình".

# Nhà cung cấp: anthropic (mặc định) hoặc openai (mọi API tương thích OpenAI)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Tên mô hình (tùy chọn; mặc định: claude-sonnet-5-5 hoặc gpt-4o-mini)
# LLM_MODEL=

# Đường dẫn file SQLite (tùy chọn; mặc định data/guard.db)
# BNPL_DB_PATH=data/guard.db
